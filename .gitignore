# Xcode
build/
DerivedData/
/Blatta.xcodeproj/
# xcuserdata can appear at any depth (e.g. *.xcodeproj/project.xcworkspace/xcuserdata).
# A leading **/ is required so the pattern is not anchored to the repo root.
**/xcuserdata/
**/xcshareddata/IDEWorkspaceChecks.plist

# Swift Package Manager
.build/
Packages/

# Python fixture checks
__pycache__/
*.pyc

# macOS
.DS_Store
*.swp
*~

# IDE
.idea/
*.code-workspace

# Remember
.remember/

# Exported app bundle
/Blatta.app

# generate_appcast working directory (release prep)
/updates/

# Playwright MCP scratch output
.playwright-mcp/

# Personal marketing drafts (not part of the repo)
/marketing/

# Private work plans and local writing-tool files
/.project/
/.vale.local.ini
/.vale-ste.local.yml

# Local Apple signing identity
/Configuration/LocalSigning.xcconfig
